#!/bin/sh
# Run bat with secrets masked. Works when symlinked onto PATH.
self=$0
while [ -L "$self" ]; do
	dir=$(cd "$(dirname "$self")" && pwd)
	self=$(readlink "$self")
	case $self in /*) ;; *) self=$dir/$self ;; esac
done
exec nvim --clean -l "$(cd "$(dirname "$self")" && pwd)/bat-secrets.lua" "$@"
